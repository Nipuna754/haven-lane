# Copy this file to .env.local and fill in your own values.
# .env.local is never committed (see .gitignore). On Vercel, add the same
# names under Project → Settings → Environment Variables.

# Sanity (sanity.io/manage → your project). Public IDs, not secrets.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Any long random string. Also pasted into the Sanity webhook's "Secret" box.
SANITY_REVALIDATE_SECRET=

# Supabase (Project Settings → API). Server-only: no NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
